{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/build",
  "functions": {
    "api/socket-io/[...path].js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/rtc/",
      "destination": "/api/socket-io/conn"
    },
    {
      "source": "/rtc/:path*",
      "destination": "/api/socket-io/conn"
    },
    {
      "source": "/rtc",
      "destination": "/api/socket-io/conn"
    },
    {
      "source": "/((?!api/|rtc).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

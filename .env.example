# Copy to .env (server) and client/.env (client), then fill in.
# Anything prefixed REACT_APP_ is baked into the client bundle at build time and
# is therefore PUBLIC — never put a real secret behind that prefix.

# ---------------------------------------------------------------- signalling --
# Where the client reaches the signalling server.
# Leave unset in production: the client then connects to its own origin and the
# Vercel Function at /api/socket-io. Set it only when pointing a local client at
# a remote server.
# REACT_APP_SOCKET_URL=http://localhost:8000

# Allowed CORS origins for the standalone dev server, comma separated.
CLIENT_URL=http://localhost:3000

# Port for the standalone dev server.
PORT=8000

# --------------------------------------------------------------------- redis --
# REQUIRED on Vercel. Socket.IO keeps room membership in the memory of a single
# process; Vercel Functions run many instances with no affinity between
# connections, so without this two people in the same room can land on different
# instances and never see each other. It will appear to work in testing with one
# instance and fail intermittently under real traffic.
#
# Provision from the Vercel Marketplace (Upstash Redis) and use the TCP URL,
# not the REST one — the Socket.IO adapter needs the Redis protocol.
# Not needed for local development: without it the server uses its in-memory
# adapter, which is correct for a single process.
# REDIS_URL=rediss://default:password@host:6379

# ---------------------------------------------------------------------- turn --
# Without TURN, calls fail whenever both participants are behind symmetric NAT
# (common on corporate networks and mobile carriers). STUN alone cannot find a
# route in that case and the call hangs in "connecting" forever. Expect roughly
# 15-20% of real-world calls to fail if these are unset.
#
# Options: run coturn yourself, or use a hosted provider such as Twilio,
# Metered, or Cloudflare Calls.
#
# These are visible to anyone who loads the app, so use short-lived credentials
# from your provider rather than a permanent password.
# REACT_APP_TURN_URL=turn:your-turn-server.com:3478
# REACT_APP_TURN_USERNAME=username
# REACT_APP_TURN_CREDENTIAL=credential
